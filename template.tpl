___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const copyFromDataLayer = require('copyFromDataLayer');
const copyFromWindow = require('copyFromWindow');
const createQueue = require('createQueue');
const logToConsole = require('logToConsole');
const makeString = require('makeString');
const getType = require('getType');
const Object = require('Object');

const RESULT_EVENT = data.eventName || 'event_spec_check';
const event = makeString(copyFromDataLayer('event') || '');

// Skip Tag Manager's own events and this tag's results, so it can fire on every custom event.
if (!event || event === 'undefined' || event.indexOf('gtm.') === 0 || event === RESULT_EVENT) {
  data.gtmOnSuccess();
  return;
}

// The sandbox doesn't guarantee String.trim, so this removes spaces, tabs and carriage returns.
const trim = function (value) {
  const str = makeString(value);
  let start = 0;
  let end = str.length;
  while (start < end && ' \t\r'.indexOf(str.charAt(start)) > -1) start++;
  while (end > start && ' \t\r'.indexOf(str.charAt(end - 1)) > -1) end--;
  return str.slice(start, end);
};

// GA4's naming rules for web streams, from Google's "Event naming rules" and "Event collection
// limits" pages (checked 7 November 2026). Names collected automatically on the web, such as
// page_view or form_submit, aren't listed: sending them through Tag Manager is normal.
const RESERVED_EVENTS = ['app_remove', 'app_store_refund', 'app_store_subscription_cancel',
  'app_store_subscription_renew', 'error', 'first_open', 'first_visit', 'in_app_purchase', 'session_start',
  'user_engagement'];
const EVENT_PREFIXES = ['query_id'];
const PARAM_PREFIXES = ['_', 'firebase_', 'ga_', 'google_', 'gtag.'];
const PERSONAL = ['email', 'e_mail', 'email_address', 'phone', 'telephone', 'first_name', 'firstname', 'last_name',
  'lastname', 'full_name', 'fullname', 'surname', 'address', 'postcode', 'post_code', 'zip_code', 'zipcode',
  'date_of_birth', 'dob', 'passport'];
const MAX_NAME = 40;
const MAX_VALUE = 100;
// GA4 allows longer values for these three.
const LONG_VALUES = {page_location: 1000, page_referrer: 420, page_title: 300};
const MAX_PARAMS = 25;
// GA4 allows non-English letters, so only spaces, line breaks, punctuation and symbols count as
// invalid: all ASCII punctuation, plus the typographic and currency characters that get pasted in.
const PUNCTUATION = ' \t\r\n\u00a0!"#$%&\'()*+,-./:;<=>?@[\\]^`{|}~\u00a3\u00a7\u00b0\u00b7\u2013\u2014\u2018\u2019\u201c\u201d\u2026\u20ac';
const DIGITS = '0123456789';

const startsWithAny = function (name, list) {
  for (let i = 0; i < list.length; i++) if (name.indexOf(list[i]) === 0) return true;
  return false;
};
const nameProblem = function (name) {
  if (name.length > MAX_NAME) return 'over_40_characters';
  const first = name.charAt(0);
  if (first === '_' || DIGITS.indexOf(first) > -1 || PUNCTUATION.indexOf(first) > -1) return 'must_start_with_a_letter';
  for (let i = 0; i < name.length; i++) if (PUNCTUATION.indexOf(name.charAt(i)) > -1) return 'invalid_characters';
  return '';
};
const looksPersonal = function (name) {
  const n = '_' + name.toLowerCase() + '_';
  for (let i = 0; i < PERSONAL.length; i++) if (n.indexOf('_' + PERSONAL[i] + '_') > -1) return true;
  return false;
};

const issues = [];

// 1. The event name.
if (data.checkNames) {
  const problem = nameProblem(event);
  if (problem) issues.push('event_name_' + problem);
  if (RESERVED_EVENTS.indexOf(event) > -1) issues.push('event_name_reserved');
  if (startsWithAny(event, EVENT_PREFIXES)) issues.push('event_name_reserved_prefix');
}

// 2. Find this event's own push. Tag Manager stamps each processed push with gtm.uniqueEventId,
// which tells two pushes of the same event apart. If that isn't there, use the latest push with
// this event name.
// A push made by another custom template (with createQueue) can come back wrapped in an outer
// object, so look one level inside an entry that has no event of its own.
const unwrap = function (entry) {
  if (!entry || getType(entry) !== 'object') return undefined;
  if (entry.event !== undefined) return entry;
  const keys = Object.keys(entry);
  if (keys.length === 1 && entry[keys[0]] && getType(entry[keys[0]]) === 'object') return entry[keys[0]];
  return entry;
};
const dl = copyFromWindow('dataLayer');
const eventId = copyFromDataLayer('gtm.uniqueEventId');
let push;
if (getType(dl) === 'array') {
  for (let i = dl.length - 1; i >= 0; i--) {
    const entry = unwrap(dl[i]);
    if (entry && entry.event === event && entry['gtm.uniqueEventId'] === eventId) { push = entry; break; }
  }
  if (!push) {
    for (let i = dl.length - 1; i >= 0; i--) {
      const entry = unwrap(dl[i]);
      if (entry && entry.event === event) { push = entry; break; }
    }
  }
}
if (!push) {
  issues.push('push_not_found');
} else {
  // 3. Parameter names and values, including those inside ecommerce.
  // The count includes the ecommerce fields, as a cautious estimate of GA4's 25-parameter limit.
  let count = 0;
  const checkParams = function (obj, prefix) {
    const keys = Object.keys(obj);
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      if (key === 'event' || key.indexOf('gtm.') === 0 || key === 'eventCallback' || key === 'eventTimeout') continue;
      if (prefix === '' && key === 'ecommerce') {
        if (getType(obj[key]) === 'object') checkParams(obj[key], 'ecommerce.');
        continue;
      }
      count++;
      if (data.checkNames) {
        const problem = nameProblem(key);
        if (problem) issues.push('param_' + problem + ':' + prefix + key);
        if (startsWithAny(key, PARAM_PREFIXES)) issues.push('param_reserved_prefix:' + prefix + key);
        if (looksPersonal(key)) issues.push('param_may_be_personal_data:' + prefix + key);
        const limit = LONG_VALUES[key] || MAX_VALUE;
        if (getType(obj[key]) === 'string' && obj[key].length > limit) issues.push('param_value_too_long:' + prefix + key);
      }
    }
  };
  checkParams(push, '');
  if (data.checkNames && count > MAX_PARAMS) issues.push('over_25_parameters');

  // 4. Required parameters from the settings: one line per event, "event: param, param.path".
  const lines = makeString(data.requiredParams || '').split('\n');
  for (let i = 0; i < lines.length; i++) {
    const colon = lines[i].indexOf(':');
    if (colon === -1 || trim(lines[i].slice(0, colon)) !== event) continue;
    const required = lines[i].slice(colon + 1).split(',');
    for (let j = 0; j < required.length; j++) {
      const path = trim(required[j]);
      if (!path) continue;
      let value = push;
      const steps = path.split('.');
      for (let k = 0; k < steps.length && value !== undefined && value !== null; k++) {
        value = getType(value) === 'object' ? value[steps[k]] : undefined;
      }
      if (value === undefined || value === null || value === '' || (getType(value) === 'array' && value.length === 0)) {
        issues.push('missing:' + path);
      }
    }
  }
}

logToConsole('Event spec check (Metric Owl): ' + event + ': ' + (issues.length ? issues.join(', ') : 'no issues found'));
if (data.pushEvent) {
  createQueue('dataLayer')({
    event: RESULT_EVENT,
    event_spec_event: event,
    event_spec_status: issues.length ? 'issues' : 'ok',
    event_spec_issues: issues.join(',')
  });
}
data.gtmOnSuccess();


