___TESTS___

setup: |-
  const pushed = [];
  mock('createQueue', function () { return function (o) { pushed.push(o); }; });
  const spec = 'purchase: ecommerce.transaction_id, ecommerce.value, ecommerce.currency, ecommerce.items';
scenarios:
- name: A complete purchase passes
  code: |-
    mock('copyFromDataLayer', 'purchase');
    mock('copyFromWindow', [{event: 'gtm.js'}, {event: 'purchase', ecommerce: {transaction_id: 'T1', value: 10, currency: 'GBP', items: [{item_id: 'A'}]}}]);
    runCode({requiredParams: spec, checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_status).isEqualTo('ok');
    assertThat(pushed[0].event_spec_event).isEqualTo('purchase');
    assertApi('gtmOnSuccess').wasCalled();
- name: Missing parameters are listed
  code: |-
    mock('copyFromDataLayer', 'purchase');
    mock('copyFromWindow', [{event: 'purchase', ecommerce: {value: 10, items: []}}]);
    runCode({requiredParams: spec, checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('missing:ecommerce.transaction_id,missing:ecommerce.currency,missing:ecommerce.items');
- name: Only this event's latest push counts
  code: |-
    mock('copyFromDataLayer', 'purchase');
    mock('copyFromWindow', [{event: 'purchase', ecommerce: {transaction_id: 'OLD', value: 1, currency: 'GBP', items: [1]}}, {event: 'purchase', ecommerce: {value: 10, currency: 'GBP', items: [1]}}]);
    runCode({requiredParams: spec, checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('missing:ecommerce.transaction_id');
- name: Bad, reserved and personal names are reported
  code: |-
    mock('copyFromDataLayer', 'Form Submit');
    mock('copyFromWindow', [{event: 'Form Submit', user_email: 'a@b.c', ga_source: 'x', '1st_field': 'y'}]);
    runCode({requiredParams: '', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('event_name_invalid_characters,param_may_be_personal_data:user_email,param_reserved_prefix:ga_source,param_must_start_with_a_letter:1st_field');
- name: Reserved event names and long values
  code: |-
    mock('copyFromDataLayer', 'session_start');
    mock('copyFromWindow', [{event: 'session_start', note: 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'}]);
    runCode({requiredParams: '', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('event_name_reserved,param_value_too_long:note');
- name: Non-English letters, user_id and currency are allowed
  code: |-
    mock('copyFromDataLayer', function (k) { return k === 'event' ? 'achat_réussi' : undefined; });
    mock('copyFromWindow', [{event: 'achat_réussi', user_id: 'U1', currency: 'EUR', catégorie: 'x'}]);
    runCode({requiredParams: '', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_status).isEqualTo('ok');
- name: Two pushes of the same event are told apart
  code: |-
    mock('copyFromDataLayer', function (k) { return k === 'event' ? 'view_item_list' : 5; });
    mock('copyFromWindow', [{event: 'view_item_list', 'gtm.uniqueEventId': 5}, {event: 'view_item_list', 'gtm.uniqueEventId': 6, ecommerce: {items: [1]}}]);
    runCode({requiredParams: 'view_item_list: ecommerce.items', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('missing:ecommerce.items');
- name: Ecommerce fields count towards the 25-parameter limit
  code: |-
    mock('copyFromDataLayer', function (k) { return k === 'event' ? 'big' : undefined; });
    const p = {event: 'big', ecommerce: {value: 1, currency: 'GBP', items: [1], tax: 0, shipping: 0}};
    for (let i = 0; i < 22; i++) p['p' + i] = i;
    mock('copyFromWindow', [p]);
    runCode({requiredParams: '', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('over_25_parameters');
- name: Page addresses can be longer than 100 characters
  code: |-
    mock('copyFromDataLayer', 'virtual_page_view');
    mock('copyFromWindow', [{event: 'virtual_page_view', page_location: 'https://example.co.uk/a-very-long-path-that-goes-on-and-on-for-well-over-one-hundred-characters-in-total/with/more/segments?x=1'}]);
    runCode({requiredParams: '', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_status).isEqualTo('ok');
- name: Tag Manager events and its own results are skipped
  code: |-
    mock('copyFromDataLayer', 'gtm.dom');
    runCode({requiredParams: spec, checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    mock('copyFromDataLayer', 'event_spec_check');
    runCode({requiredParams: spec, checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed.length).isEqualTo(0);
    assertApi('gtmOnSuccess').wasCalled();
- name: A push it can't find is reported
  code: |-
    mock('copyFromDataLayer', 'sign_up');
    mock('copyFromWindow', undefined);
    runCode({requiredParams: '', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('push_not_found');
- name: A push wrapped by another template is found
  code: |-
    mock('copyFromDataLayer', function (k) { return k === 'event' ? 'sign_up' : 3; });
    mock('copyFromWindow', [{wrapper: {event: 'sign_up', method: 'email', 'gtm.uniqueEventId': 3}}]);
    runCode({requiredParams: 'sign_up: method', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_status).isEqualTo('ok');
- name: Extra colons and pasted punctuation are handled
  code: |-
    mock('copyFromDataLayer', 'sign_up');
    mock('copyFromWindow', [{event: 'sign_up', 'plan–type': 'a', 'gtm_source': 'b'}]);
    runCode({requiredParams: 'sign_up: method, note:extra', checkNames: true, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_issues).isEqualTo('param_invalid_characters:plan–type,missing:method,missing:note:extra');
- name: Names aren't checked when the setting is off
  code: |-
    mock('copyFromDataLayer', 'Form Submit');
    mock('copyFromWindow', [{event: 'Form Submit', user_email: 'a@b.c'}]);
    runCode({requiredParams: '', checkNames: false, pushEvent: true, eventName: 'event_spec_check'});
    assertThat(pushed[0].event_spec_status).isEqualTo('ok');


